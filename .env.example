NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-a-chave-anon-public-aqui
# ATENÇÃO: chave secreta. Na Vercel marque como "Sensitive". Nunca coloque no código.
SUPABASE_SERVICE_ROLE_KEY=cole-a-chave-service_role-aqui
